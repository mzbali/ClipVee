#!/bin/sh
# Fails a push on the compile errors that would fail the CI "build and unit tests" job, in a minute
# instead of a CI round. Built after 11 Nov, when CI run 43002011370 failed on
# Maccy/Extensions/Defaults.Keys+Names.swift:29:14 "main actor-isolated default value in a
# nonisolated context". Builds the app and test targets (build-for-testing, no test run) of the
# checked-out commit and refuses uncommitted changes. CI has no docs-only skip, so neither does this.
# Enable once per clone; worktrees share it: git config core.hooksPath .githooks
set -eu
cd "$(git rev-parse --show-toplevel)"
# The build reads the checkout, so it can only vouch for the checked-out commit; CI builds any other.
zero=0000000000000000000000000000000000000000
head=$(git rev-parse HEAD)
build=false
while read -r _ local_sha _ _; do
  [ "$local_sha" = "$zero" ] && continue   # deleting a branch
  if [ "$local_sha" = "$head" ]; then build=true
  else echo "pre-push: $local_sha is not checked out, leaving its build to CI" >&2; fi
done
[ "$build" = true ] || exit 0
if ! git diff --quiet HEAD --; then
  echo "pre-push: uncommitted changes would be built instead of the pushed commit; commit or stash them" >&2
  exit 1
fi
export DEVELOPER_DIR="${DEVELOPER_DIR:-/Applications/Xcode.app/Contents/Developer}"
echo "pre-push: xcodebuild build-for-testing (scheme ClipVee, Debug)" >&2
xcodebuild -project Maccy.xcodeproj -scheme ClipVee -configuration Debug \
  -derivedDataPath .build/DerivedData \
  -clonedSourcePackagesDirPath .build/SourcePackages -skipPackageUpdates \
  CODE_SIGN_IDENTITY=- CODE_SIGN_STYLE=Manual DEVELOPMENT_TEAM= \
  -quiet build-for-testing
